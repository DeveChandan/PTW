# SAP Gateway Dev System URL (Used by Vite proxy in development)
VITE_SAP_TARGET=https://vhgfldevci.sap.gfl.co.in:44300

# SAP Client ID
VITE_SAP_CLIENT=200

# OData V4 Service Base Path
VITE_ODATA_BASE_URL=/sap/opu/odata4/sap/zptw_mamagement_srv/srvd_a2x/sap/zptw_services/0001/

# Default Initial SAP User ID
VITE_INITIAL_USER_ID=VERTIF-V

# PMIntegration work selection. Backend additions are specified in docs/permit-work-selection.md.
# The date property must be Edm.Date; the shutdown value is a trusted OData filter expression.
VITE_PTW_WORK_ENTITY=PMIntegration
VITE_PTW_WORK_DATE_FIELD=WorkDate
VITE_PTW_SHUTDOWN_FILTER=IsShutdown eq true
